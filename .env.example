# TALOS — autonomous AI treasury agent
# Data: SoSoValue OpenAPI (live)  |  Execution: SoDEX (simulation by default)

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
BASE_PATH=/

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/talos

# --- SoSoValue OpenAPI (real market data) ---
# Docs: https://sosovalue.gitbook.io/soso-value-api-doc/
SOSO_API_KEY=your_soso_api_key_here
SOSO_BASE_URL=https://openapi.sosovalue.com/openapi/v1
SOSO_RATE_PER_MIN=8

# --- TALOS agent config ---
# TALOS_MODE: simulation | autonomous
TALOS_MODE=simulation
TALOS_SYMBOL=BTC
TALOS_INDEX=ssiMAG7
TALOS_NEWS_CATEGORY=1
TALOS_MAX_TRADE_PCT=20
TALOS_MAX_RISK_SCORE=70
TALOS_PORTFOLIO={"BTC":0.5,"ETH":4,"USDS":1000}

# --- AI providers (multi-provider fallback: OpenAI -> Anthropic -> Groq) ---
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-REPLACE_ME
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- SoDEX execution (used only when TALOS_MODE=autonomous) ---
# Mainnet: https://mainnet-gw.sodex.dev/api/v1/spot   (ValueChain chainId 286623)
# Testnet: https://testnet-gw.sodex.dev/api/v1/spot   (ValueChain chainId 138565) [future]
SODEX_BASE_URL=https://mainnet-gw.sodex.dev/api/v1/spot
# SODEX_SIGNER_KEY=  EIP-712 signer; leave empty in simulation mode
